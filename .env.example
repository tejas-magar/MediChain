# ==============================================================================
# MediLedger - Environment Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to .env in apps/api/.env for local backend development.
# IMPORTANT: This template contains placeholders only. Do NOT put secrets here.
# ==============================================================================

# ── Backend API Configuration (apps/api) ─────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Database & Sessions ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<database_name>"
SESSION_SECRET="your-at-least-32-character-session-secret-goes-here"

# ── Frontend Web Configuration (apps/web) ────────────────────────────────────
VITE_API_URL=http://localhost:3001
